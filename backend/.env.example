# Copy to backend/.env for local development. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# MongoDB Atlas connection string (server-side only).
# Atlas > Connect > Drivers. Replace <user>, <password>, <cluster> and pick a database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/life-in-clips?retryWrites=true&w=majority

# Gemini API key (server-side only). Used to mint short-lived Live API tokens for the voice coach.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Shared secret that protects the whole API (you type it once in the app).
# REQUIRED in production (at least 16 characters). Optional locally. Generate one with:
#   node -p "require('crypto').randomBytes(24).toString('base64url')"
ACCESS_KEY=

# Browser origin(s) allowed by CORS: your frontend URL, comma-separated for several.
# Required in production, e.g. https://life-in-clips.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Local API port (not used on Vercel).
PORT=3001

# Optional overrides.
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Kore
# GEMINI_API_VERSION=v1alpha
# TRUST_PROXY=1
