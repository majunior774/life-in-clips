# Copy to frontend/.env for local development (optional; defaults work with the local backend).
# On Vercel, set VITE_API_URL in Project Settings -> Environment Variables.
# Everything here is PUBLIC (embedded in the browser bundle). Never put secrets in VITE_* variables.

# Production: the deployed backend's address, no trailing slash.
# VITE_API_URL=https://your-backend.vercel.app

# Development only: where the dev server proxies /api (default shown).
# DEV_API_TARGET=http://localhost:3001
